# Supabase Dashboard → Connect → Transaction pooler URI.
# Never expose this value to public/app.js or commit it to Git.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase requires SSL. Keep this unset in production; set only for a local non-SSL Postgres instance.
# DATABASE_SSL=disable
